# Copy to `.env` (gitignored) and set for your machine/network.
# Expo exposes EXPO_PUBLIC_* vars to the app at build time.

# Base URL of the PHP backend the app talks to. Use your dev machine's LAN IP
# for a physical device, 10.0.2.2 for the Android emulator, localhost for iOS sim.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8090

# Shared secret matching config.php's `api_token` on the server. Required for
# the phone to write over the LAN (auth-guard.php only trusts loopback without
# it). Leave empty only if the server has no api_token set (loopback-only).
EXPO_PUBLIC_API_TOKEN=
